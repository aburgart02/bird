		{
			"name": "GitHub Callback",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.token) {",
							"    pm.collectionVariables.set('token', jsonData.token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
