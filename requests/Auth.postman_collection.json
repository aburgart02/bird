						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"code\": \"YOUR_GITHUB_AUTH_CODE\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/auth/github/callback",
					"host": [
